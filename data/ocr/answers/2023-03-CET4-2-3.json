33.0], [796.0, 633.0], [796.0, 659.0], [178.0, 659.0]], "进行的活动，故译文时态应采用一般现在时。分析", 0.88765679753345], [[[869.0, 647.0], [1490.0, 647.0], [1490.0, 676.0], [869.0, 676.0]], "和“促进农村经济发展”可处理为and连接的并列", 0.898927832643191], [[[177.0, 677.0], [797.0, 679.0], [797.0, 708.0], [177.0, 706.0]], "可知，可将逗号前的内容处理为主干句，逗号后的", 0.9112625329390817], [[[871.0, 697.0], [1472.0, 697.0], [1472.0, 723.0], [871.0, 723.0]], "请宾。具体翻译时，可将“实际上”处理为状语，", 0.856421525063722], [[[178.0, 728.0], [783.0, 728.0], [783.0, 754.0], [178.0, 754.0]], "内容处理为现在分词短语，作主干句的伴随状语，", 0.8812403134677721], [[[871.0, 744.0], [1490.0, 744.0], [1490.0, 773.0], [871.0, 773.0]], "置于句首，译为\"Infact”并用逗号将其与后面", 0.8835667955875397], [[[177.0, 773.0], [801.0, 775.0], [801.0, 805.0], [177.0, 803.0]], "置于句末。具体翻译时“有些游客”可译为“Some", 0.9314196133613586], [[[871.0, 794.0], [1495.0, 794.0], [1495.0, 823.0], [871.0, 823.0]], "的内容隔开；“这种旅游形式”可译为“thisformof", 0.8940858635409125], [[[867.0, 842.0], [1492.0, 842.0], [1492.0, 875.0], [867.0, 875.0]], "tourism”；“能使城市游客受益”可译为“canbenefit", 0.9157656667863622], [[[174.0, 870.0], [799.0, 866.0], [799.0, 900.0], [174.0, 904.0]], "participate in activities such as fruit picking\"“亲身", 0.8798397762271074], [[[869.0, 890.0], [1492.0, 890.0], [1492.0, 923.0], [869.0, 923.0]], "urban tourists”“能增加农民的收人”可译为“can", 0.8969354629516602], [[[175.0, 911.0], [798.0, 915.0], [798.0, 951.0], [175.0, 947.0]], "感受.”可译为“experiencing...at first hand”·“收", 0.8412054377358135], [[[869.0, 941.0], [1489.0, 938.0], [1489.0, 968.0], [869.0, 971.0]], "increasefarmers\"income”为符合英文表达习惯，可", 0.9000489635126931], [[[176.0, 962.0], [652.0, 964.0], [652.0, 996.0], [176.0, 994.0]], "获的喜悦”可译为“thejoyof harvest”。", 0.8875576108694077], [[[869.0, 990.0], [1489.0, 990.0], [1489.0, 1019.0], [869.0, 1019.0]], "将第一个can置于notonly之前，第二个can省略；“促", 0.9099315635619625], [[[146.0, 1012.0], [797.0, 1012.0], [797.0, 1038.0], [146.0, 1038.0]], "4.原句译文乡村旅游能够有效地帮助游客舒缓压", 0.8974018096923828], [[[869.0, 1037.0], [1496.0, 1040.0], [1496.0, 1069.0], [869.0,